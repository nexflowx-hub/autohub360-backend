NODE_ENV=production
HOST=0.0.0.0
PORT=8090
SERVICE_VERSION=0.1.0
LOG_LEVEL=info

# Docker internal Redis address. Never expose Redis on the host.
REDIS_URL=redis://autohub360-redis:6379

# AutoHub360 Supabase project
SUPABASE_URL=https://eivqvrfsreaopzlvhadu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Server-to-server/admin token for protected operational endpoints.
# Generate in production and keep only in /srv/secrets/autohub360/backend.env.
INTERNAL_API_TOKEN=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://autohub360.store,https://autohub360.tech,https://admin.autohub360.tech
